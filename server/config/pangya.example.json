// Modelo da configuração. Copie para config/pangya.json (tools/setup-dev.sh faz isso e gera a senha do banco).
{
  // Portas de desenvolvimento (não colidem com o emulador Python em 80/10101/20201).
  // Num servidor de verdade: Web 80, Login 10101, Game 20201.
  "Run": ["web", "login", "game", "game-jp", "messenger", "messenger-jp", "ranking", "ranking-jp"],
  "Game": { "Id": 30201, "Name": "PangYa C#", "Port": 30201, "MaxUsers": 1000, "Channels": [ { "Name": "Canal 1", "MaxUsers": 100 } ] },
  // Game server do cliente JP 983 (o login na 30101 atende os dois clientes; o JP só vê este servidor na lista).
  "GameJp": { "Id": 30202, "Name": "PangYa C# JP", "Port": 30202, "MaxUsers": 1000, "Property": 2048, "EventFlags": 0, "EventValue": 0, "IconIndex": 0, "Channels": [ { "Name": "Channel 1", "MaxUsers": 100 } ] },
  "Web": { "Port": 30080, "AutoRegister": false },
  "Login": { "Ports": [30101], "ServerUid": 10101 },
  "Messenger": { "Id": 30303, "Name": "Messenger", "Port": 30303, "MaxUsers": 3000 },
  "MessengerJp": { "Id": 30304, "Name": "Messenger JP", "Port": 30304, "MaxUsers": 3000 },
  "Ranking": { "Id": 30474, "Name": "Ranking", "Port": 30474, "RefreshHour": 5 },
  "RankingJp": { "Id": 30475, "Name": "Ranking JP", "Port": 30475, "RefreshHour": 5 },
  "Network": {
    "BindIp": "0.0.0.0",
    "PublicIp": "127.0.0.1"
  },
  "Database": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=pangya;Username=pangya;Password=CHANGE_ME"
  },
  "Logging": {
    "Level": "Info",
    "Dir": "logs",
    "PacketHex": false
  },
  "Data": {
    "IffPath": "data/pangya.iff"
  },
  "Lottery": {
    "PapelPrice": 900,
    "PapelBallWeights": [35, 30, 20, 10, 5],
    "ScratchCountWeights": [30, 69, 1]
  },
  "Limits": {
    "MaxConnectionsPerIp": 10,
    "MaxPacketsPerSecond": 100,
    "MaxPacketSize": 8192,
    "MaxLoginAttemptsPerMinute": 10,
    "IdleTimeoutSeconds": 120
  }
}
