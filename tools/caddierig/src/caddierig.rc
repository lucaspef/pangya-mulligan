// Icon and version resource. Everything else in the UI is built in code so the
// language can be switched at run time.
#include <winver.h>

1 ICON "caddierig.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,21,0,0
 PRODUCTVERSION 2,21,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CaddieRig"
            VALUE "FileVersion", "2.21"
            VALUE "ProductName", "CaddieRig"
            VALUE "ProductVersion", "2.21"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
